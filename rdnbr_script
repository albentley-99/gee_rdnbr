// ##############################################################
// Extract Acquisition Dates to Report Number of Images
// ##############################################################
function ymdList(imgcol){
    var iter_func = function(image, newlist){
        var date = ee.Number.parse(image.date().format("YYYYMMdd"));
        newlist = ee.List(newlist);
        return ee.List(newlist.add(date))
    };
    return imgcol.iterate(iter_func, ee.List([]));
}
var dates = ymdList(LS_NBR_all);

// print acquisition dates
print(dates, "Acquisition Dates");


// ##############################################################
// Calculate Desired Statistic of NBR Per Annual Window
// ##############################################################

var years = ee.List.sequence(startYear, endYear);

var annualNBR = ee.ImageCollection(
  years.map(function(y){
    var yearly = LS_NBR_all
      .filter(ee.Filter.calendarRange(y, y, 'year'))
      .median()                                                       //change to mean, min, max, etc as needed
      .rename(ee.String('NBR_').cat(ee.Number(y).int().format())); // remove decimal
    return yearly.set('year', y);
  })
);

//Print Average Values
print(annualNBR, "annualNBR");

// ##############################################################
// Calculate Relative dNBR (RdNBR = dNBR / sqrt(|NBR_previous|))
// ##############################################################
annualNBR = annualNBR.sort('year');

var nbrList = annualNBR.toList(annualNBR.size());

var deltaNBR = ee.ImageCollection(
  ee.List.sequence(1, nbrList.size().subtract(1)).map(function(i) {

    i = ee.Number(i);

    var current = ee.Image(nbrList.get(i));
    var previous = ee.Image(nbrList.get(i.subtract(1)));

    var year = ee.Number(current.get('year')).int();

    // Calculate dNBR
    var dNBR = previous.subtract(current);

    // Calculate RdNBR
    var rdNBR = dNBR.divide(previous.abs().sqrt().max(0.001))
      .rename(ee.String('delta_NBR_').cat(ee.Number(year).format()))
      .set('year', year);

    return rdNBR;
  })
);

// Extract only Positive Values (vegetation loss)
deltaNBR = deltaNBR.map(function(img){
  return img.updateMask(img.gt(0));
});

// ##############################################################
// Export Indvidual Layers to Drive
// ##############################################################

var ExportCol = function(col, folder, scale, type, nimg, maxPixels, region) {

  type = type || "float";
  scale = scale || 30;
  maxPixels = maxPixels || 1e13;

  var colList = col.toList(col.size());
  var n = colList.size().getInfo();

  for (var i = 0; i < n; i++) {

    var img = ee.Image(colList.get(i));
    var year = img.get('year').getInfo();  // use stored year property

    var imgtype = {
      "float": img.toFloat(),
      "byte": img.toByte(),
      "int": img.toInt(),
      "double": img.toDouble()
    };

    Export.image.toDrive({
      image: imgtype[type],
      description: 'delta_NBR_' + year,
      folder: folder,
      fileNamePrefix: 'delta_NBR_' + year,
      region: region,
      crs: 'EPSG:5070',
      scale: scale,
      maxPixels: maxPixels
    });
  }
};

ExportCol(deltaNBR, 'gee_nbr', 30, "float", "null", 1e13, AOI)
