// Landsat C2 // Note that C2 Standardizes QA Bands Across Generations, but that SR Bands are Different

function mask_sr8_9(image) {
  // Bits 4 and 3 are cloud shadow and cloud, respectively.
  var cloudShadowBitMask = 1 << 4;
  var cloudsBitMask = 1 << 3;

  // Get the pixel QA band.
  var qa = image.select('QA_PIXEL');

  // Both flags should be set to zero, indicating clear conditions.
  var mask = qa.bitwiseAnd(cloudShadowBitMask).eq(0)
      .and(qa.bitwiseAnd(cloudsBitMask).eq(0));

  // Return the masked image, scaled to reflectance (within 0 - 1), without the QA bands.
 var scaled = image.updateMask(mask).multiply(0.0000275).add(-0.2)
      .select('SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7');

  // Mask out-of-range reflectance values
  var validRange = scaled.gte(0).and(scaled.lte(1));
  scaled = scaled.updateMask(validRange);

  return scaled.copyProperties(image, ["system:time_start"]);
}

function mask_sr4_5_7(image) {
  // Bits 4 and 3 are cloud shadow and cloud, respectively.
  var cloudShadowBitMask = 1 << 4;
  var cloudsBitMask = 1 << 3;

  // Get the pixel QA band.
  var qa = image.select('QA_PIXEL');

  // Both flags should be set to zero, indicating clear conditions.
  var mask = qa.bitwiseAnd(cloudShadowBitMask).eq(0)
      .and(qa.bitwiseAnd(cloudsBitMask).eq(0));

  // Return the masked image, scaled to reflectance (within 0 - 1), without the QA bands.
 var scaled = image.updateMask(mask).multiply(0.0000275).add(-0.2)
      .select('SR_B1','SR_B2','SR_B3','SR_B4','SR_B5', 'SR_B7');

  // Mask out-of-range reflectance values
  var validRange = scaled.gte(0).and(scaled.lte(1));
  scaled = scaled.updateMask(validRange);

  return scaled.copyProperties(image, ["system:time_start"]);
}
 
// #############################################
// define function to calculate Landsat NBR
// separate function for Landsat 4+5+7 and Landsat 8 + 9
// #############################################    

var addNBR_LS4_5_7 = function(image) {
  var nbr = image.expression(
    '(B4 - B7)/(B4 + B7)', {
      B4: image.select('SR_B4'),
      B7: image.select('SR_B7')
    }
  ).rename('NBR');

  return image.addBands(nbr);
};

var addNBR_LS8_9 = function(image) {
  var nbr = image.expression(
    '(B5 - B7)/(B5 + B7)', {
      B5: image.select('SR_B5'),
      B7: image.select('SR_B7')
    }
  ).rename('NBR');

  return image.addBands(nbr);
};

